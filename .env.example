# Web3Forms — get your free access key at https://web3forms.com
VITE_WEB3FORMS_KEY=your_access_key_here

# GitHub — fine-grained personal access token (read-only, public repos).
# Used by the build-time project snapshot (scripts/fetch-projects.mjs)
# and the /api/projects Vercel Function. Set in the Vercel dashboard:
# Settings -> Environment Variables (Production).
GITHUB_TOKEN=your_github_token_here

# Resend — API key for the contact form's /api/contact Vercel Function.
# Get one at https://resend.com (free tier: 100 emails/day).
# Set in the Vercel dashboard: Settings -> Environment Variables (Production).
RESEND_API_KEY=your_resend_api_key_here

# Contact form destination email (optional — defaults to mhtamim136@gmail.com
# when unset). Set in the Vercel dashboard:
# Settings -> Environment Variables (Production).
CONTACT_TO_EMAIL=mhtamim136@gmail.com
